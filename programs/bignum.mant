; bignum.mant -- a 48-bit counter made of four floats.
;
; A float loses count at 16,777,216.  Keep the number as four limbs of 12
; bits, f0 to f3 from most to least significant, and every limb stays small
; and exact.  Incrementing is add and carry.  Printing is repeated division
; by ten on a copy, which is chop and mod on numbers no larger than 45,000.

        LDI.H  h9, 7             ; how many counts to print
        LDI.H  h8, 1
        LDI.F  f9, 10
        LDI.F  f10, 4096         ; the base
        LDI.F  f0, 0             ; 16,777,214 is 4095 * 4096 + 4094
        LDI.F  f1, 0
        LDI.F  f2, 4095
        LDI.F  f3, 4094
again:  JAL    f7, print
        LDI.H  h0, 10
        PUTC.H h0
        ; add one, limb by limb, carrying whatever reaches the base
        LDI.F  f4, 1
        ADD.F  f3, f3, f4
        DIV.F  f5, f3, f10
        CHOP.F f5, f5
        MOD.F  f3, f3, f10
        ADD.F  f2, f2, f5
        DIV.F  f5, f2, f10
        CHOP.F f5, f5
        MOD.F  f2, f2, f10
        ADD.F  f1, f1, f5
        DIV.F  f5, f1, f10
        CHOP.F f5, f5
        MOD.F  f1, f1, f10
        ADD.F  f0, f0, f5
        MOD.F  f0, f0, f10
        SUB.H  h9, h9, h8
        BNZ.H  h9, again
        HALT

; print: the number held in f0 to f3, in decimal.  The limbs are left as
; they were: the division works on a copy in f20 to f23.
print:  MOV    f20, f0
        MOV    f21, f1
        MOV    f22, f2
        MOV    f23, f3
        LDI.F  f11, 0            ; how many digits
        LDI.F  f12, digits       ; where to store them, last digit first
        LDI.F  f13, 1
next:   JAL    f15, div10        ; leaves the digit in f8
        CVT.H  h0, f8
        ST.H   [f12], h0
        ADD.F  f12, f12, f13
        ADD.F  f11, f11, f13
        ADD.F  f5, f20, f21      ; anything left?
        ADD.F  f5, f5, f22
        ADD.F  f5, f5, f23
        BNZ.F  f5, next
        LDI.H  h1, 48
back:   SUB.F  f12, f12, f13
        LD.H   h0, [f12]
        ADD.H  h0, h0, h1
        PUTC.H h0
        LDI.F  f14, digits
        BNE.F  f12, f14, back
        JMP    f7

; div10: divide the copy in f20 to f23 by ten (f9), leaving the digit in f8.
div10:  LDI.F  f8, 0
        MUL.F  f5, f8, f10
        ADD.F  f5, f5, f20
        DIV.F  f6, f5, f9
        CHOP.F f20, f6
        MOD.F  f8, f5, f9
        MUL.F  f5, f8, f10
        ADD.F  f5, f5, f21
        DIV.F  f6, f5, f9
        CHOP.F f21, f6
        MOD.F  f8, f5, f9
        MUL.F  f5, f8, f10
        ADD.F  f5, f5, f22
        DIV.F  f6, f5, f9
        CHOP.F f22, f6
        MOD.F  f8, f5, f9
        MUL.F  f5, f8, f10
        ADD.F  f5, f5, f23
        DIV.F  f6, f5, f9
        CHOP.F f23, f6
        MOD.F  f8, f5, f9
        JMP    f15

digits: SPACE 32
