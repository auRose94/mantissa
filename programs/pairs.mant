; pairs.mant -- casts that keep what a plain cast drops.
;
; SPLIT hands a number to two narrower ones and JOIN takes it back.  MANT
; scales a number into the first binade, where every format has its full
; precision, and hands back the power of two it used; SCALB undoes that.
        LDI.D  d0, 10000000001
        LDI.F  f5, t_plain
        JAL    f4, puts
        CVT.F  f0, d0            ; the plain cast keeps the nearest float
        PUT.F  f0
        LDI.F  f5, t_split
        JAL    f4, puts
        SPLIT  f1, f2, d0        ; two floats keep the 1
        PUT.F  f1
        PUT.F  f2
        LDI.F  f5, t_join
        JAL    f4, puts
        JOIN   d1, f1, f2
        PUT.D  d1
        LDI.F  f5, t_edge
        JAL    f4, puts
        LDI.D  d0, 562949970198528     ; the largest whole number a float pair keeps
        SPLIT  f1, f2, d0
        JOIN   d1, f1, f2
        PUT.D  d1
        LDI.F  f5, t_half
        JAL    f4, puts
        LDI.D  d0, 6.02e23
        CVT.H  h0, d0            ; no half can hold this
        PUT.H  h0
        LDI.F  f5, t_mant
        JAL    f4, puts
        MANT   h6, h7, d0        ; ... but a half holds its mantissa, and its exponent
        PUT.H  h6
        PUT.H  h7
        LDI.F  f5, t_back
        JAL    f4, puts
        CVT.D  d2, h6
        CVT.D  d3, h7
        SCALB  d4, d2, d3        ; and scaling puts the number back
        PUT.D  d4
        HALT

; puts: print the string of half code points at address f5, ended by a 0.
; f4 holds the address JAL left there; jump back to it when done.
puts:   LD.H   h0, [f5]
        BZ.H   h0, puts_done
        PUTC.H h0
        LDI.H  h1, 1
        CVT.F  f6, h1
        ADD.F  f5, f5, f6
        BR     puts
puts_done:
        JMP    f4

t_plain:  TEXT "a plain cast to float:  "
          DATA.H 0
t_split:  TEXT "split into two floats:  "
          DATA.H 0
t_join:   TEXT "joined back:            "
          DATA.H 0
t_edge:   TEXT "the last one kept:      "
          DATA.H 0
t_half:   TEXT "6.02e23 as a half:      "
          DATA.H 0
t_mant:   TEXT "its mantissa, exponent: "
          DATA.H 0
t_back:   TEXT "scaled back:            "
          DATA.H 0
